# Hidden files/dirs — strict policy: keep them out
.*
!.gitignore
!.gitattributes
!.htaccess

node_modules/
.DS_Store
.vscode/
vendor/
*.log
.env

# Per-site configuration files (not committed to repo)
# These contain site-specific settings like site_id, passwords, etc.
registration.local.yaml
wp-config-geodineum.yaml

# Archived documentation (historical session handoffs, outdated docs)
archive/

# Session and mission working documents (not permanent documentation)
*.scn.md
# …except the permanent contract primer, which is tracked alongside CONTRACT.md
!CONTRACT.scn.md
MISSION_*.md
SESSION_*.md
AUDIT_*.md
RUN_MANUALLY_*.md
CLAUDE.md
SCN-GUIDE.md

# Build artifacts (generated by scripts/build-css.sh)
assets/css/gcube.built.css

# Internal dev snapshots / lockfiles (themes don't need lock pinning)
DIRECTORY_TREE_*.txt
*_BEFORE_REFACTOR.txt
composer.lock

# Editor/tool backup files
*.backup
*.bak
